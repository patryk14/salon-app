# LOCAL environment configuration (docker compose).
#
# Copy: cp .env.example .env   (`make up` does it for you if .env does not exist)
# The file is OPTIONAL: docker-compose.yml carries the same values as defaults (`${VAR:-...}`);
# .env exists to override them (e.g. a different port or bucket).
#
# NOTE: every value below is EXPLICITLY NON-SECRET — these are logins to containers on
# your laptop (MinIO, Postgres, Mailpit), not to AWS. This file is committed on purpose.
# The real .env is gitignored.
#
# In AWS the same variable names receive different values (RDS, real S3, SES), and
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are NOT set at all — the container gets its
# permissions from an IAM role. The code does not change.
#
# The `api` container does NOT receive this whole file — compose passes it an explicit
# list of variables (the `environment` section in docker-compose.yml). Variables marked
# "read only by container X" never reach api.

# --- application -----------------------------------------------------------
APP_ENV=local
# Origins the browser may call the API from (frontend). In AWS: https://charmskin.pl
CORS_ORIGINS=http://localhost:4321

# --- database (locally: db container; in AWS: RDS) --------------------------
DATABASE_URL=postgresql+psycopg://salon:salon@db:5432/salon
# These three are read only by the `db` container on first start; they must match DATABASE_URL.
POSTGRES_USER=salon
POSTGRES_PASSWORD=salon
POSTGRES_DB=salon

# --- photos / S3 API (locally: MinIO; in AWS: S3) ---------------------------
# In AWS leave S3_ENDPOINT_URL EMPTY — boto3 then uses real S3 in AWS_REGION.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=salon-photos
# For now this is the MinIO root account (below). Eventually (Stage 2, photo upload)
# minio-init will create a separate user with a policy scoped to the bucket — the same
# policy will serve as the template for the IAM policy in salon-infra. Only values change, not code.
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_REGION=eu-central-1
# These two are read only by the `minio` container (and minio-init); they must match the pair above.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

# --- transactional mail (locally: Mailpit; in AWS: SES over SMTP) -----------
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- frontend (Astro dev server) --------------------------------------------
# API address as seen from the browser, hence localhost, not the compose service name.
# Read only by the `web` container; default value and type: frontend/astro.config.mjs.
PUBLIC_API_URL=http://localhost:8000
