---
// Client portal (F7) — client-facing (NOT /panel): her profile, visits, packages, vouchers.
import KlientPortal from '../components/KlientPortal.tsx';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Mój profil — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin</span>
        <h1>Mój profil</h1>
      </header>
      <KlientPortal client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 780px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.25rem; margin: 0; }
      h3 { font-size: 1.05rem; margin: 0; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.6rem; display: flex; flex-direction: column; gap: .8rem; align-items: flex-start; }
      .row { display: flex; gap: .5rem; flex-wrap: wrap; }
      input { font: inherit; border: 1px solid var(--line2); background: var(--field); color: var(--ink); border-radius: 8px; padding: .5rem .7rem; }
      .btn { font: inherit; font-size: .95rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .55rem 1rem; cursor: pointer; }
      .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      .btn:disabled { opacity: .55; cursor: default; }
      .link { background: none; border: 0; color: var(--accent); font: inherit; font-size: .85rem; cursor: pointer; text-decoration: underline; padding: 0; }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }

      .prof { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding-bottom: 1rem; margin-bottom: .5rem; border-bottom: 1px solid var(--line); }
      section { margin: 1.4rem 0; }
      .shead { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: .6rem; }
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .7rem; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: .9rem 1rem; }
      .card.due { border-color: var(--accent); background: var(--accent-soft); }
      .card-t { font-weight: 600; margin-bottom: .3rem; }
      .card-big { font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; }
      .card-big .muted { font-size: .9rem; font-weight: 400; }
      .scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
      table { border-collapse: collapse; width: 100%; min-width: 480px; }
      td { padding: .5rem .7rem; text-align: left; border-bottom: 1px solid var(--line); }
      tr:last-child td { border-bottom: 0; }
      td.nowrap { white-space: nowrap; }
      .badge { font-size: .72rem; font-weight: 700; padding: .18rem .5rem; border-radius: 999px; white-space: nowrap; }
      .badge.s-active, .badge.s-completed { background: var(--pay-soft); color: var(--pay); }
      .badge.s-used, .badge.s-used_up, .badge.s-scheduled { background: var(--accent-soft); color: var(--accent); }
      .badge.s-expired, .badge.s-cancelled, .badge.s-no_show { background: var(--err-soft); color: var(--err); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
