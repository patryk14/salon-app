---
// Staff portal (F6) — an employee's own schedule, revenue and commission.
import StaffPortal from '../../components/StaffPortal.tsx';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Portal pracownicy — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin · portal pracownicy</span>
        <h1>Moje rozliczenie</h1>
      </header>
      <StaffPortal client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 820px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.15rem; margin: 0 0 .3rem; }
      h3 { font-size: 1rem; margin: 1.4rem 0 .5rem; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .spacer { flex: 1; }
      .bar { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .month, input[type='date'] { font: inherit; padding: .45rem .55rem; border-radius: 8px; border: 1px solid var(--line2); background: var(--card); color: var(--ink); }
      .btn { font: inherit; font-size: .9rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .5rem .9rem; cursor: pointer; text-decoration: none; }
      .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }
      .codein { font: inherit; font-size: 1.1rem; letter-spacing: .12em; text-transform: uppercase; padding: .5rem .7rem; border-radius: 8px; border: 1px solid var(--line2); background: var(--field); color: var(--ink); }

      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: .8rem; margin: .4rem 0; }
      .stat { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: .9rem 1.1rem; display: flex; flex-direction: column; gap: .2rem; }
      .stat .lbl { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      .stat .big { font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; }
      .stat .big.pay { color: var(--pay); }

      .addrow { display: flex; gap: .5rem; flex-wrap: wrap; }
      .hin { width: 8rem; font: inherit; padding: .45rem .55rem; border-radius: 8px; border: 1px solid var(--line2); background: var(--field); color: var(--ink); }
      .scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
      table { border-collapse: collapse; width: 100%; min-width: 620px; font-variant-numeric: tabular-nums; }
      th, td { padding: .5rem .7rem; text-align: left; border-bottom: 1px solid var(--line); }
      th { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      td.amt { text-align: right; white-space: nowrap; }
      td.nowrap { white-space: nowrap; }
      .badge { font-size: .72rem; font-weight: 700; padding: .18rem .5rem; border-radius: 999px; }
      .badge.s-completed { background: var(--pay-soft); color: var(--pay); }
      .badge.s-cancelled { background: var(--err-soft); color: var(--err); }
      .badge.s-no_show { background: var(--draft-soft); color: var(--draft); }
      .badge.s-scheduled { background: var(--accent-soft); color: var(--accent); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
