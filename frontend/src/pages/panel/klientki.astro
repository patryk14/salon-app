---
// Clients + progress photos (F9, staff & admin). PanelNav renders only for an
// admin; staff reach this page from their own dashboard.
import ClientsView from '../../components/ClientsView.tsx';
import PanelNav from '../../components/PanelNav.astro';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Klientki i zdjęcia — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin · panel</span>
        <h1>Klientki i zdjęcia postępów</h1>
      </header>
      <PanelNav />
      <ClientsView client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 1560px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.1rem; margin: 0; }
      h2.section { margin: 1.6rem 0 .6rem; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; }
      .btn { font: inherit; font-size: .9rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .5rem .9rem; cursor: pointer; }
      .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      .btn.danger { background: var(--err); color: #fff; border-color: var(--err); white-space: nowrap; }
      .btn:disabled { opacity: .55; cursor: default; }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }
      .link { background: none; border: 0; font: inherit; font-size: .8rem; cursor: pointer; padding: 0; text-decoration: underline; }
      .link.danger { color: var(--err); align-self: flex-start; }
      input, select { font: inherit; border: 1px solid var(--line2); background: var(--field); color: var(--ink); border-radius: 8px; padding: .4rem .55rem; max-width: 100%; }

      .split { display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: 1.5rem; align-items: start; }
      @media (max-width: 760px) { .split { grid-template-columns: 1fr; } }
      .list .search { width: 100%; }
      .list p { margin: .4rem 0; }
      .list ul { list-style: none; margin: 0; padding: 0; max-height: 70vh; overflow-y: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
      .list li + li { border-top: 1px solid var(--line); }
      .row { width: 100%; display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; text-align: left; font: inherit; color: var(--ink); background: none; border: 0; padding: .5rem .7rem; cursor: pointer; }
      .row:hover { background: var(--field); }
      .row.active { background: var(--accent-soft); }
      .detail { min-width: 0; }
      .cat-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: .8rem; flex-wrap: wrap; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: .9rem 1rem; margin-bottom: .8rem; }
      .card p { margin: .35rem 0 0; }
      .chk { display: inline-flex; align-items: center; gap: .45rem; }
      .chk.strong { font-weight: 600; }
      .chk input { width: auto; }
      .upload { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
      .upload .grow { flex: 1; min-width: 10rem; }
      .badge { font-size: .68rem; font-weight: 700; padding: .12rem .45rem; border-radius: 999px; background: var(--line); color: var(--muted); }
      .badge.ok, .badge.after { background: var(--pay-soft); color: var(--pay); }
      .badge.before { background: var(--draft-soft); color: var(--draft); }

      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: .8rem; }
      figure { margin: 0; background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
      figure img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; background: var(--field); }
      figcaption { display: flex; flex-direction: column; gap: .2rem; padding: .5rem .6rem; font-size: .85rem; }

      .link { color: var(--accent); }
      .edit { display: flex; flex-wrap: wrap; gap: .6rem; align-items: flex-end; }
      .fld { display: flex; flex-direction: column; gap: .2rem; flex: 1; min-width: 9rem; }
      .fld .lbl { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      .fld input { width: 100%; }
      .edit-actions { display: flex; gap: .4rem; }
      .ph { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 3 / 4; background: var(--field); color: var(--muted); font-size: .8rem; }
      .ph-err { color: var(--err); }
      .tabs { display: flex; gap: .3rem; border-bottom: 1px solid var(--line); margin: .4rem 0 1rem; flex-wrap: wrap; }
      .tab { font: inherit; font-size: .9rem; background: none; border: 0; border-bottom: 2px solid transparent; color: var(--muted); padding: .5rem .8rem; cursor: pointer; }
      .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
      .bar { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin: .6rem 0 1rem; }
      .inline { display: inline-flex; gap: .4rem; align-items: center; }
      .chip { font: inherit; font-size: .85rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 999px; padding: .3rem .8rem; cursor: pointer; }
      .chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
      .chip.active .muted { color: #fff; opacity: .8; }
      .paper { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; }
      .paper .fld { flex: 0 0 auto; }
      .badge.warn { background: var(--draft-soft); color: var(--draft); }
      .scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; margin-bottom: .8rem; }
      table.sessions { border-collapse: collapse; width: 100%; min-width: 640px; }
      table.sessions th, table.sessions td { padding: .45rem .6rem; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
      table.sessions tr:last-child td { border-bottom: 0; }
      table.sessions th { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      table.sessions td.amt, table.sessions th.amt { text-align: right; font-variant-numeric: tabular-nums; }
      table.sessions tr.add td { background: var(--field); }
      table.sessions tr.done td { color: var(--muted); }
      table.sessions textarea, table.sessions input:not([type=date]):not(.num), table.sessions select { width: 100%; }
      table.sessions tr.add td > * + * { margin-top: .3rem; }
      textarea { font: inherit; border: 1px solid var(--line2); background: var(--field); color: var(--ink); border-radius: 8px; padding: .4rem .55rem; width: 100%; resize: vertical; }
      input.num { width: 100%; min-width: 3.6rem; text-align: right; }
      table.sessions input[type=date] { min-width: 8.5rem; }
      table.measure { min-width: 900px; }
      table.measure th, table.measure td { padding: .4rem .35rem; }
      table.measure td:first-child, table.measure th:first-child { padding-left: .6rem; }
      td.nowrap { white-space: nowrap; }
      td.pre { white-space: pre-wrap; }
      details.card summary { cursor: pointer; font-weight: 600; }
      .after { margin: .6rem 0 0; padding-left: 1.2rem; font-size: .88rem; }
      .after li + li { margin-top: .3rem; }
      .routine { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
      .routine .card { margin: 0; }
      .rhead { font-weight: 600; text-align: center; padding: .3rem; }
      @media (max-width: 560px) { .routine { grid-template-columns: 1fr; } }
      .btn.sm { padding: .3rem .7rem; font-size: .82rem; }
      .merge { margin-top: 2rem; }
      .merge input { width: 100%; max-width: 24rem; margin-top: .5rem; }
      .hits { list-style: none; margin: .5rem 0 0; padding: 0; }
      .hits li { display: flex; justify-content: space-between; align-items: center; gap: .8rem; padding: .35rem 0; border-top: 1px solid var(--line); }
      .rodo { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: .8rem; border-color: var(--err); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
