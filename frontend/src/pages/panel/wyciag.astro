---
// Bank statement → costs (admin) — import an ING MT940 (.sta) and review debits.
import StatementView from '../../components/StatementView.tsx';
import PanelNav from '../../components/PanelNav.astro';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Wyciąg → koszty — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin · panel administratora</span>
        <h1>Wyciąg bankowy → koszty</h1>
      </header>
      <PanelNav />
      <StatementView client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 960px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.05rem; margin: 0; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; }
      .btn { font: inherit; font-size: .9rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .5rem .9rem; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: .3rem; }
      .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      .btn:disabled { opacity: .55; cursor: default; }
      .link { background: none; border: 0; color: var(--accent); font: inherit; font-size: .8rem; cursor: pointer; text-decoration: underline; padding: 0; }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }

      .bar { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .bar .spacer { flex: 1; }
      .fld { display: flex; flex-direction: column; gap: .2rem; }
      .fld .lbl { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      input, select { font: inherit; border: 1px solid var(--line2); background: var(--field); color: var(--ink); border-radius: 8px; padding: .45rem .6rem; }

      .cat-head { display: flex; justify-content: space-between; align-items: center; margin: 1.2rem 0 .4rem; gap: 1rem; flex-wrap: wrap; }
      .scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
      table { border-collapse: collapse; width: 100%; min-width: 640px; }
      th, td { padding: .45rem .6rem; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
      tr:last-child td { border-bottom: 0; }
      th { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      td.amt, th.amt { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
      td.nowrap { white-space: nowrap; }
      td.del { text-align: right; white-space: nowrap; }
      .tag { font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--draft); background: var(--draft-soft); padding: .12rem .45rem; border-radius: 5px; }
      .fold { margin-top: 1rem; }
      .fold summary { cursor: pointer; color: var(--muted); font-size: .85rem; padding: .4rem 0; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
