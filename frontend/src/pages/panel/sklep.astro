---
// Shop (F11, staff & admin) — products + shelf, sales (→ commission), client
// pickup orders. PanelNav renders only for an admin; staff come from their dashboard.
import ShopView from '../../components/ShopView.tsx';
import PanelNav from '../../components/PanelNav.astro';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sklep — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin · panel</span>
        <h1>Sklep</h1>
      </header>
      <PanelNav />
      <ShopView client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.05rem; margin: 0; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; }
      .btn { font: inherit; font-size: .9rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .5rem .9rem; cursor: pointer; }
      .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      .btn.sm { padding: .28rem .6rem; font-size: .8rem; }
      .btn:disabled { opacity: .55; cursor: default; }
      .link { background: none; border: 0; font: inherit; font-size: .8rem; cursor: pointer; padding: 0 .2rem; text-decoration: underline; color: var(--accent); }
      .link.danger { color: var(--err); }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }
      .ok { background: var(--pay-soft); color: var(--pay); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }
      input, select { font: inherit; border: 1px solid var(--line2); background: var(--field); color: var(--ink); border-radius: 8px; padding: .4rem .55rem; max-width: 100%; }
      input.num { width: 5.5rem; text-align: right; }
      .tabs { display: flex; gap: .3rem; border-bottom: 1px solid var(--line); margin: .4rem 0 1rem; flex-wrap: wrap; }
      .tab { font: inherit; font-size: .9rem; background: none; border: 0; border-bottom: 2px solid transparent; color: var(--muted); padding: .5rem .8rem; cursor: pointer; }
      .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
      .scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; margin-bottom: .7rem; }
      table { border-collapse: collapse; width: 100%; min-width: 640px; }
      th, td { padding: .45rem .7rem; text-align: left; border-bottom: 1px solid var(--line); vertical-align: middle; }
      tr:last-child td { border-bottom: 0; }
      th { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      td.amt, th.amt { text-align: right; font-variant-numeric: tabular-nums; }
      td.nowrap { white-space: nowrap; }
      td.actions { white-space: nowrap; text-align: right; }
      td.actions > * + * { margin-left: .3rem; }
      td.empty { text-align: center; padding: 1.2rem; }
      tr.add td { background: var(--field); }
      tr.add input:not(.num) { width: 100%; }
      tr.retired td { color: var(--muted); }
      tr.hist td { background: var(--field); font-size: .88rem; }
      tr.hist ul { margin: 0; padding-left: 1.1rem; }
      .cell { border: 1px solid transparent; background: transparent; }
      .cell:hover, .cell:focus { border-color: var(--line2); background: var(--field); }
      .neg { color: var(--err); }
      .warn { color: var(--draft); }
      .badge { font-size: .68rem; font-weight: 700; padding: .12rem .45rem; border-radius: 999px; background: var(--line); color: var(--muted); }
      .badge.ok { background: var(--pay-soft); color: var(--pay); }
      .badge.warn { background: var(--draft-soft); color: var(--draft); }
      .chk { display: inline-flex; align-items: center; gap: .35rem; font-size: .85rem; color: var(--muted); }
      .chk input { width: auto; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: .9rem 1rem; margin-bottom: .8rem; }
      .sellbox, .bar { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
      .sellbox select:first-child { flex: 1; min-width: 14rem; }
      .cat-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin: 1rem 0 .5rem; flex-wrap: wrap; }
      .order .cat-head { margin-top: 0; }
      .order ul { margin: .3rem 0 .7rem; padding-left: 1.2rem; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
