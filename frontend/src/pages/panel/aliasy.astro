---
// Alias management — map Booksy staff names to employees (closing the Booksy
// revenue-attribution loop) and clear the month's unmatched names.
import AliasManager from '../../components/AliasManager.tsx';
import PanelNav from '../../components/PanelNav.astro';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Aliasy pracownic — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin · panel administratora</span>
        <h1>Aliasy pracownic</h1>
      </header>
      <PanelNav />
      <AliasManager client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 980px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.1rem; margin: 0 0 .3rem; }
      h3 { font-size: 1rem; margin: 0 0 .6rem; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .ok { color: var(--pay); font-weight: 600; }
      .bar { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; margin-bottom: .8rem; }
      .spacer { flex: 1; }
      .month { font: inherit; padding: .45rem .55rem; border-radius: 8px; border: 1px solid var(--line2); background: var(--card); color: var(--ink); }
      .btn { font: inherit; font-size: .9rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .5rem .9rem; cursor: pointer; text-decoration: none; }
      .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }

      .unmatched { background: var(--draft-soft); border: 1px solid var(--draft); border-radius: 12px; padding: 1rem 1.1rem; margin: .8rem 0 1.2rem; }
      .unmatched h2 { color: var(--draft); }
      .unlist { list-style: none; margin: .6rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .5rem; }
      .unlist li { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
      .assign { display: inline-flex; align-items: center; gap: .4rem; font-size: .85rem; color: var(--muted); }
      .assign select { font: inherit; font-size: .85rem; padding: .3rem .4rem; border-radius: 7px; border: 1px solid var(--line2); background: var(--card); color: var(--ink); }

      .chip { display: inline-flex; align-items: center; gap: .3rem; font-size: .82rem; background: var(--accent-soft); color: var(--accent); border-radius: 999px; padding: .22rem .6rem; }
      .chip.warn { background: #fff; color: var(--draft); border: 1px solid var(--draft); font-weight: 600; }
      .chip .x { border: none; background: transparent; color: inherit; cursor: pointer; font-size: 1.05rem; line-height: 1; padding: 0; }

      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .8rem; margin-top: 1rem; }
      .ecard { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: .9rem 1rem; }
      .aliases { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .7rem; min-height: 1.6rem; }
      .addrow { display: flex; gap: .4rem; }
      .aliasin { flex: 1; min-width: 0; font: inherit; font-size: .85rem; padding: .4rem .5rem; border-radius: 7px; border: 1px solid var(--line2); background: var(--field); color: var(--ink); }
      .mini { font: inherit; font-size: .82rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 7px; padding: .4rem .7rem; cursor: pointer; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
