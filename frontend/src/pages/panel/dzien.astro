---
// Daily reporting screen — hours + cash per employee per day. Same styles as
// the settlement panel (global block in panel/index.astro would not apply here,
// so the shared tokens/classes are duplicated).
import DailyEntry from '../../components/DailyEntry.tsx';
import PanelNav from '../../components/PanelNav.astro';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Raport dzienny — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin · panel administratora</span>
        <h1>Raport dzienny</h1>
      </header>
      <PanelNav />
      <DailyEntry client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 900px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.15rem; margin: 0 0 .5rem; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .bar { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .month { font: inherit; padding: .4rem .5rem; border-radius: 8px; border: 1px solid var(--line2); background: var(--card); color: var(--ink); }
      .btn { font: inherit; font-size: .9rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .5rem .9rem; cursor: pointer; text-decoration: none; }
      .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
      .mini { font: inherit; font-size: .74rem; font-weight: 600; color: var(--accent); background: var(--card); border: 1px solid var(--line2); border-radius: 6px; padding: .3rem .5rem; margin-left: .4rem; cursor: pointer; }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; max-width: 32rem; }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }
      /* card-per-employee layout — stacks on any width, no wide table */
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
      .empcard { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.1rem; }
      .cardhead { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; flex-wrap: wrap; padding-bottom: .7rem; border-bottom: 1px solid var(--line); margin-bottom: .7rem; }
      .empname { font-weight: 700; font-size: 1.02rem; }
      .hours { font-size: .8rem; color: var(--muted); }
      .fld { font: inherit; font-size: .88rem; background: var(--field); border: 1px solid var(--line); border-radius: 6px; padding: .32rem .45rem; color: var(--ink); }
      .hours-in { width: 3.4rem; text-align: right; font-variant-numeric: tabular-nums; }
      .sect { margin-top: .8rem; }
      .secthead { display: flex; justify-content: space-between; align-items: baseline; font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--accent); }
      .secthead .sum { color: var(--muted); font-weight: 600; text-transform: none; letter-spacing: 0; font-variant-numeric: tabular-nums; }
      ul.entries { list-style: none; margin: .5rem 0; padding: 0; display: flex; flex-direction: column; gap: .3rem; }
      ul.entries li { display: flex; align-items: center; gap: .5rem; font-size: .86rem; }
      ul.entries .svc { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      ul.entries .amt { font-variant-numeric: tabular-nums; font-weight: 600; }
      .del { font: inherit; font-size: .72rem; color: var(--err); background: var(--err-soft); border: none; border-radius: 5px; padding: .18rem .45rem; cursor: pointer; }
      .addrow { display: flex; gap: .35rem; margin-top: .5rem; }
      .svc-in { flex: 1; min-width: 0; }
      .amt-in { width: 4.6rem; text-align: right; font-variant-numeric: tabular-nums; }
      .btn.small { font-size: .78rem; padding: .32rem .6rem; }
      .kasa { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.1rem; margin-top: 1.2rem; }
      .kasa h3 { margin: 0 0 .7rem; font-size: 1.05rem; }
      .kasarow { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1rem; }
      .kfield { display: flex; flex-direction: column; gap: .2rem; min-width: 9rem; }
      .klbl { font-size: .66rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      .kval { font-size: 1.25rem; font-weight: 700; font-variant-numeric: tabular-nums; }
      .khint { font-size: .72rem; color: var(--muted); }
      .kin { width: 8rem; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
