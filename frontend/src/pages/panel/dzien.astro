---
// Daily reporting screen — hours + cash per employee per day. Same styles as
// the settlement panel (global block in panel/index.astro would not apply here,
// so the shared tokens/classes are duplicated).
import DailyEntry from '../../components/DailyEntry.tsx';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Raport dzienny — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin · panel administratora</span>
        <h1>Raport dzienny</h1>
      </header>
      <DailyEntry client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 900px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.15rem; margin: 0 0 .5rem; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .bar { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .month { font: inherit; padding: .4rem .5rem; border-radius: 8px; border: 1px solid var(--line2); background: var(--card); color: var(--ink); }
      .btn { font: inherit; font-size: .9rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .5rem .9rem; cursor: pointer; text-decoration: none; }
      .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
      .mini { font: inherit; font-size: .74rem; font-weight: 600; color: var(--accent); background: var(--card); border: 1px solid var(--line2); border-radius: 6px; padding: .3rem .5rem; margin-left: .4rem; cursor: pointer; }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; max-width: 32rem; }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }
      .scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
      table { border-collapse: collapse; width: 100%; min-width: 620px; font-variant-numeric: tabular-nums; }
      th, td { padding: .55rem .7rem; text-align: right; border-bottom: 1px solid var(--line); white-space: nowrap; }
      th { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      th:first-child, td:first-child { text-align: left; }
      td.name { font-weight: 600; }
      td.out { color: var(--muted); }
      input.cell { width: 6rem; text-align: right; font: inherit; font-size: .88rem; background: var(--field); border: 1px solid var(--line); border-radius: 6px; padding: .3rem .4rem; color: var(--ink); }
      input.cell.narrow { width: 4.4rem; }
      input.cell.name-in { width: 7rem; text-align: left; margin-right: .3rem; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
