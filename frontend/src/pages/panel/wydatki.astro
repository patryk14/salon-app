---
// Expenses & monthly P&L (admin) — the salon's cost side and real profit.
import ExpensesView from '../../components/ExpensesView.tsx';
import PanelNav from '../../components/PanelNav.astro';
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Wydatki i zysk — Charm Skin</title>
  </head>
  <body>
    <main>
      <header>
        <span class="eyebrow">Charm Skin · panel administratora</span>
        <h1>Wydatki i zysk (P&amp;L)</h1>
      </header>
      <PanelNav />
      <ExpensesView client:only="preact" />
    </main>

    <style is:global>
      :root {
        --paper: #f6f2ef; --card: #fff; --ink: #2c2320; --muted: #8a7d76;
        --line: #e9dfd8; --line2: #dccec4; --accent: #8a4d6d; --accent-soft: #f3e6ed;
        --pay: #2f7d5b; --pay-soft: #e2f0e8; --draft: #a86a1f; --draft-soft: #f6ead6;
        --err: #b4462f; --err-soft: #f8e4de; --field: #fbf8f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #1b1917; --card: #262220; --ink: #ece5e1; --muted: #a99d95;
          --line: #372f2c; --line2: #463c37; --accent: #d295b3; --accent-soft: #38262f;
          --pay: #77c39b; --pay-soft: #1e3329; --draft: #e0ac6a; --draft-soft: #362a1a;
          --err: #e5917c; --err-soft: #3a251f; --field: #201d1b;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 900px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
      h1 { margin: .2rem 0 1.4rem; font-size: 1.7rem; font-weight: 600; }
      h2 { font-size: 1.02rem; margin: 0; }
      .muted { color: var(--muted); }
      .small { font-size: .82rem; }
      .gate { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; }
      .btn { font: inherit; font-size: .9rem; border: 1px solid var(--line2); background: var(--card); color: var(--ink); border-radius: 8px; padding: .5rem .9rem; cursor: pointer; text-decoration: none; }
      .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      .btn.sm { padding: .3rem .7rem; font-size: .82rem; }
      .btn:disabled { opacity: .55; cursor: default; }
      .err { background: var(--err-soft); color: var(--err); border-radius: 8px; padding: .6rem .8rem; margin-bottom: .8rem; font-size: .88rem; }
      .link { background: none; border: 0; color: var(--accent); font: inherit; font-size: .8rem; cursor: pointer; padding: 0 0 0 .5rem; text-decoration: underline; }

      .bar { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
      .bar .spacer { flex: 1; }
      .fld { display: flex; flex-direction: column; gap: .2rem; }
      .fld .lbl { font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      input { font: inherit; border: 1px solid var(--line2); background: var(--field); color: var(--ink); border-radius: 8px; padding: .45rem .6rem; }
      .badge { font-size: .72rem; font-weight: 700; padding: .2rem .55rem; border-radius: 999px; }
      .badge.s-active { background: var(--draft-soft); color: var(--draft); }
      .badge.s-expired { background: var(--pay-soft); color: var(--pay); }

      /* P&L summary waterfall */
      .pl { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.2rem; margin-bottom: 1rem; }
      .pl-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .3rem 0; }
      .pl-label { color: var(--muted); font-size: .9rem; }
      .pl-row.strong .pl-label { color: var(--ink); font-weight: 600; }
      .pl-val { font-variant-numeric: tabular-nums; white-space: nowrap; }
      .pl-row.strong .pl-val { font-weight: 700; font-size: 1.05rem; }
      .pl-val.pos { color: var(--pay); }
      .pl-val.neg { color: var(--err); }
      .rule { height: 1px; background: var(--line); margin: .35rem 0; }
      .derived .ov { margin-left: .5rem; display: inline-flex; gap: .3rem; align-items: center; }
      .derived .ov input { width: 8rem; }

      /* Category tables */
      .cat { margin: 1rem 0; }
      .cat-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .3rem; }
      .cat-total { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--accent); }
      th.amt { text-align: right; }
      .pos { color: var(--pay); font-weight: 600; }
      .neg { color: var(--err); font-weight: 600; }
      .tag { font-size: .66rem; font-weight: 700; letter-spacing: .04em; color: var(--muted); background: var(--line); padding: .1rem .35rem; border-radius: 5px; }
      .scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
      table { border-collapse: collapse; width: 100%; }
      td { padding: .25rem .5rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
      tr:last-child td { border-bottom: 0; }
      .cell { width: 100%; border: 1px solid transparent; background: transparent; }
      .cell:hover:not(:disabled), .cell:focus { border-color: var(--line2); background: var(--field); }
      .cell.num { text-align: right; font-variant-numeric: tabular-nums; }
      td.amt { width: 9rem; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
      /* break-even table has many numeric columns — size to content + scroll, not the wide P&L width */
      table.staff { min-width: 720px; }
      table.staff td.amt, table.staff th.amt { width: auto; }
      table.staff td, table.staff th { padding: .45rem .8rem; }
      table.staff th:first-child, table.staff td:first-child { text-align: left; }
      td.src { width: 4rem; }
      td.del { width: 2rem; text-align: center; }
      .tag { font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); background: var(--line); padding: .12rem .4rem; border-radius: 5px; }
      .x { border: 0; background: none; color: var(--muted); font-size: 1.2rem; line-height: 1; cursor: pointer; padding: 0 .3rem; }
      .x:hover { color: var(--err); }
      tr.add td { background: var(--field); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    </style>
  </body>
</html>
