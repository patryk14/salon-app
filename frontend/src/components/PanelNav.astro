---
// Shared admin navigation wrapper. The links live in a client island
// (PanelNavLinks) that renders ONLY for a logged-in admin, so anonymous
// visitors and staff never see the admin page structure. This file only
// carries the (global) styles + mounts the island.
import PanelNavLinks from './PanelNavLinks.tsx';
---

<PanelNavLinks client:only="preact" />

<style is:global>
  .pnav { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin-bottom: 1.4rem; padding-bottom: .9rem; border-bottom: 1px solid var(--line); }
  .pnav-group { display: flex; flex-direction: column; gap: .25rem; }
  .pnav-title { font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .pnav-links { display: flex; flex-wrap: wrap; gap: .3rem; }
  .pnav-link { font-size: .85rem; text-decoration: none; color: var(--ink); background: var(--card); border: 1px solid var(--line2); border-radius: 7px; padding: .32rem .6rem; }
  .pnav-link:hover { border-color: var(--accent); }
  .pnav-link.active { background: var(--accent); color: #fff; border-color: var(--accent); }
</style>
