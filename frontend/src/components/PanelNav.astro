---
// Shared admin navigation, grouped into sections (Rozliczenia / Zespół /
// Operacje) so the panel stays legible as pages grow. Rendered at the top of
// every admin page; the island bars keep only their functional controls.
// Uses the CSS vars each page already defines on :root.
const path = Astro.url.pathname.replace(/\/$/, '') || '/panel';
const groups: { title: string; links: [string, string][] }[] = [
  {
    title: 'Rozliczenia',
    links: [
      ['/panel', 'Rozliczenie'],
      ['/panel/dzien', 'Raport dzienny'],
      ['/panel/wizyty', 'Wizyty'],
      ['/panel/booksy', 'Booksy'],
      ['/panel/aliasy', 'Aliasy'],
    ],
  },
  {
    title: 'Zespół',
    links: [
      ['/panel/konta', 'Konta'],
      ['/panel/dokumenty', 'Dokumenty'],
      ['/panel/dyspozycyjnosc', 'Grafik'],
    ],
  },
  {
    title: 'Operacje',
    links: [['/panel/zaopatrzenie', 'Zamówienia']],
  },
];
---

<nav class="pnav">
  {
    groups.map((g) => (
      <div class="pnav-group">
        <span class="pnav-title">{g.title}</span>
        <div class="pnav-links">
          {g.links.map(([href, label]) => (
            <a href={href} class:list={['pnav-link', { active: path === href }]}>
              {label}
            </a>
          ))}
        </div>
      </div>
    ))
  }
</nav>

<style is:global>
  .pnav { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin-bottom: 1.4rem; padding-bottom: .9rem; border-bottom: 1px solid var(--line); }
  .pnav-group { display: flex; flex-direction: column; gap: .25rem; }
  .pnav-title { font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .pnav-links { display: flex; flex-wrap: wrap; gap: .3rem; }
  .pnav-link { font-size: .85rem; text-decoration: none; color: var(--ink); background: var(--card); border: 1px solid var(--line2); border-radius: 7px; padding: .32rem .6rem; }
  .pnav-link:hover { border-color: var(--accent); }
  .pnav-link.active { background: var(--accent); color: #fff; border-color: var(--accent); }
</style>
